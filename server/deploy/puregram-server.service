[Unit]
Description=Puregram Control API (FastAPI)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/puregram-server
# Secrets live in /opt/puregram-server/.env (NOT in git). Must define:
#   PUREGRAM_JWT_SECRET=<long random string>
#   PUREGRAM_COOKIE_SECURE=true
#   PUREGRAM_DATABASE_URL=postgresql://puregram:<password>@127.0.0.1:5432/puregram
# Optional:
#   PUREGRAM_DB_POOL_MIN=2
#   PUREGRAM_DB_POOL_MAX=10
#   PUREGRAM_ALLOWED_ORIGINS=https://puregram.app
EnvironmentFile=/opt/puregram-server/.env
ExecStart=/opt/puregram-server/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
