# ── Secrets: never commit these ────────────────────────────────────────────
# Telegram API credentials. Publishing an api_id/api_hash pair breaks Telegram's
# API terms and gets the pair banned — every builder uses their own.
telegram/api_credentials.bat
local.properties
**/local.properties

# Signing keys and their passwords. A leaked upload key lets someone else sign
# releases as you; a leaked release key lets them ship an "update" to installed
# apps. These live outside the repository (see BUILDING.md).
*.keystore
*.jks
*.p12
*.pem
keystore*.properties
play-assets/keystore/

# Server secrets.
.env
server/.env
*.env.local

# ── Build output ───────────────────────────────────────────────────────────
build/
out/
.gradle/
.cxx/
node_modules/
__pycache__/
*.pyc
venv/

# Large release artifacts — published on puregram.app, not in git.
releases/
play-assets/*.aab
*.apk
*.exe
*.pdb
*.zip

# Both client forks live in this repository, under telegram/. What is NOT kept
# here is anything a build produces or downloads: the desktop fork's third-party
# dependencies stay as git submodules (pointers, not copies), and the prebuilt
# Windows libraries are fetched by the documented build steps, not committed.
telegram/Libraries/
telegram/ThirdParty/
telegram/*.bat
!telegram/configure_telegram.bat
!telegram/build_telegram.bat
!telegram/prepare_libs.bat

# ── Local noise ────────────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# Telegram session files — a live sign-in, never commit.
*.session
*.session-journal
